{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=iPoolDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "Issuer": "iPool",
    "Audience": "iPoolUsers",
    "ExpireMinutes": 60,
    "ClockSkewSeconds": 60
  },
  "PasswordHash": {
    "Iterations": 100000,
    "SaltSize": 16,
    "KeySize": 32
  },
  "AppInfo": {
    "Name": "iPool API",
    "Environment": "Development"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
